<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pure CPU Pixel Engine</title>
    <style>
        body {
            background-color: #080808;
            color: #00ffaa;
            font-family: monospace;
            text-align: center;
            margin: 0;
            padding: 20px;
            overflow: hidden;
        }
        h2 { margin: 5px 0; text-shadow: 0 0 10px rgba(0,255,170,0.4); }
        canvas {
            border: 4px solid #222;
            box-shadow: 0 0 40px rgba(0, 255, 170, 0.15);
            background-color: #000;
            image-rendering: pixelated;
        }
        .stats {
            margin-top: 8px;
            font-size: 15px;
            color: #888;
        }
        span { color: #fff; font-weight: bold; }
    </style>
</head>
<body>

    <h2>RAW CPU PIXEL-BUFFER ARCADE ENGINE</h2>
    <canvas id="gameCanvas" width="512" height="384"></canvas>
    <div class="stats">
        Move: [W, A, S, D] | Aim: [Mouse] | Shoot: [Left Click] | Score: <span id="scoreVal">0</span>
    </div>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        const WIDTH = 256;  // Low internal resolution for raw retro pixel performance
        const HEIGHT = 192;
        
        // Create an explicit raw pixel buffer array (RGBA)
        const imgData = ctx.createImageData(WIDTH, HEIGHT);
        const data = imgData.data;

        let score = 0;
        let player = { x: WIDTH / 2, y: HEIGHT / 2, radius: 4, speed: 1.5 };
        let mouse = { x: 0, y: 0, down: false };
        
        let bullets = [];
        let enemies = [];
        let particles = [];
        let frameCount = 0;

        // Input handling mapped precisely to scaled canvas dimensions
        window.addEventListener('mousemove', e => {
            const rect = canvas.getBoundingClientRect();
            mouse.x = (e.clientX - rect.left) * (WIDTH / rect.width);
            mouse.y = (e.clientY - rect.top) * (HEIGHT / rect.height);
        });
        window.addEventListener('mousedown', () => mouse.down = true);
        window.addEventListener('mouseup', () => mouse.down = false);

        const keys = {};
        window.addEventListener('keydown', e => keys[e.key.toLowerCase()] = true);
        window.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);

        function spawnEnemy() {
            let edge = Math.floor(Math.random() * 4);
            let ex, ey;
            if (edge === 0) { ex = Math.random() * WIDTH; ey = -10; }
            else if (edge === 1) { ex = WIDTH + 10; ey = Math.random() * HEIGHT; }
            else if (edge === 2) { ex = Math.random() * WIDTH; ey = HEIGHT + 10; }
            else { ex = -10; ey = Math.random() * HEIGHT; }

            enemies.push({ x: ex, y: ey, speed: 0.6 + Math.random() * 0.6, health: 2 });
        }

        function createExplosion(x, y, colorR, colorG, colorB) {
            for (let i = 0; i < 16; i++) {
                let angle = Math.random() * Math.PI * 2;
                let speed = 0.5 + Math.random() * 2;
                particles.push({
                    x: x, y: y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    life: 25,
                    r: colorR, g: colorG, b: colorB
                });
            }
        }

        // Fast raw pixel drawing utility directly modifying memory buffers
        function drawPixel(x, y, r, g, b) {
            let px = x | 0;
            let py = y | 0;
            if (px >= 0 && px < WIDTH && py >= 0 && py < HEIGHT) {
                let index = (py * WIDTH + px) * 4;
                data[index]     = r;
                data[index + 1] = g;
                data[index + 2] = b;
                data[index + 3] = 255;
            }
        }

        function drawLine(x0, y0, x1, y1, r, g, b) {
            let dx = Math.abs(x1 - x0);
            let dy = Math.abs(y1 - y0);
            let sx = (x0 < x1) ? 1 : -1;
            let sy = (y0 < y1) ? 1 : -1;
            let err = dx - dy;

            while (true) {
                drawPixel(x0, y0, r, g, b);
                if (Math.abs(x0 - x1) < 0.5 && Math.abs(y0 - y1) < 0.5) break;
                let e2 = 2 * err;
                if (e2 > -dy) { err -= dy; x0 += sx; }
                if (e2 < dx) { err += dx; y0 += sy; }
            }
        }

        function drawFilledCircle(cx, cy, radius, r, g, b) {
            let r2 = radius * radius;
            for (let y = -radius; y <= radius; y++) {
                for (let x = -radius; x <= radius; x++) {
                    if (x * x + y * y <= r2) {
                        drawPixel(cx + x, cy + y, r, g, b);
                    }
                }
            }
        }

        function update() {
            frameCount++;
            if (frameCount % 45 === 0) spawnEnemy();

            // Player Movement
            if (keys['w'] && player.y > 4) player.y -= player.speed;
            if (keys['s'] && player.y < HEIGHT - 4) player.y += player.speed;
            if (keys['a'] && player.x > 4) player.x -= player.speed;
            if (keys['d'] && player.x < WIDTH - 4) player.x += player.speed;

            // Shooting mechanism
            if (mouse.down && frameCount % 10 === 0) {
                let angle = Math.atan2(mouse.y - player.y, mouse.x - player.x);
                bullets.push({
                    x: player.x, y: player.y,
                    vx: Math.cos(angle) * 3.5,
                    vy: Math.sin(angle) * 3.5
                });
            }

            // Update Bullets
            for (let i = bullets.length - 1; i >= 0; i--) {
                let b = bullets[i];
                b.x += b.vx;
                b.y += b.vy;
                if (b.x < 0 || b.x > WIDTH || b.y < 0 || b.y > HEIGHT) {
                    bullets.splice(i, 1);
                }
            }

            // Update Enemies & Collisions
            for (let i = enemies.length - 1; i >= 0; i--) {
                let en = enemies[i];
                let angle = Math.atan2(player.y - en.y, player.x - en.x);
                en.x += Math.cos(angle) * en.speed;
                en.y += Math.sin(angle) * en.speed;

                // Check bullet collisions
                for (let j = bullets.length - 1; j >= 0; j--) {
                    let b = bullets[j];
                    let distSq = (b.x - en.x) * (b.x - en.x) + (b.y - en.y) * (b.y - en.y);
                    if (distSq < 25) {
                        en.health--;
                        bullets.splice(j, 1);
                        if (en.health <= 0) {
                            createExplosion(en.x, en.y, 255, 60, 100);
                            enemies.splice(i, 1);
                            score += 100;
                            document.getElementById("scoreValinnerText") = score;
                            document.getElementById("scoreVal").innerText = score;
                        }
                        break;
                    }
                }
            }

            // Update Particles
            for (let i = particles.length - 1; i >= 0; i--) {
                let p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.life--;
                if (p.life <= 0) particles.splice(i, 1);
            }
        }

        function render() {
            // Clear pixel buffer background (Deep dark scanline-style fade)
            data.fill(0);

            // Draw grid lines manually into CPU buffer for retro aesthetic
            for (let x = 0; x < WIDTH; x += 32) {
                for (let y = 0; y < HEIGHT; y++) {
                    drawPixel(x, y, 15, 15, 20);
                }
            }

            // Render Particles
            for (let p of particles) {
                let intensity = (p.life / 25);
                drawPixel(p.x, p.y, (p.r * intensity) | 0, (p.g * intensity) | 0, (p.b * intensity) | 0);
            }

            // Render Bullets
            for (let b of bullets) {
                drawFilledCircle(b.x, b.y, 1.5, 255, 255, 0);
            }

            // Render Enemies
            for (let en of enemies) {
                drawFilledCircle(en.x, en.y, 3.5, 255, 50, 80);
            }

            // Render Player Core
            drawFilledCircle(player.x, player.y, 4, 0, 255, 170);
            
            // Draw player aim vector line
            let aimAngle = Math.atan2(mouse.y - player.y, mouse.x - player.x);
            drawLine(player.x, player.y, player.x + Math.cos(aimAngle) * 8, player.y + Math.sin(aimAngle) * 8, 0, 200, 255);

            // Push the completed pixel array chunk straight to the canvas context
            ctx.putImageData(imgData, 0, 0);
        }

        function loop() {
            update();
            render();
            requestAnimationFrame(loop);
        }

        requestAnimationFrame(loop);
    </script>
</body>
</html>
